#!/usr/bin/env bash
# Copy the reference fixtures from the pinned phit commit into tests/fixtures.
# Usage: bin/fetch-fixtures [path-to-phit-checkout]
# Without a path, the repository in tests/fixtures/REFERENCE is cloned to a temp dir.
# The copies are committed as-is; never edit them by hand.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
pin="$root/tests/fixtures/REFERENCE"
commit="$(sed -n 's/^commit=//p' "$pin")"
repository="$(sed -n 's/^repository=//p' "$pin")"
source="${1:-${PHIT_REPO:-}}"
if [ -z "$source" ]; then
    source="$(mktemp -d)"
    trap 'rm -rf "$source"' EXIT
    git clone --quiet --filter=blob:none --no-checkout "$repository" "$source"
fi
files=(
    php-api.json
    descriptive-r.json
    distributions-r.json
    distributions-scipy.json
    distributions-mpmath.json
    iv-r.json
    ols-r.json
    logistic-r.json
    probit-r.json
    poisson-r.json
    r-compatibility.json
    stress-r.json
    formula-r.json
    rng-python-r.json
    draws-python.json
    lmm-r.json
    lmm-expanded-r.json
    lmm-public-r.json
    logistic-mixed-r.json
    formula-lme4-r.json
    predict-r.json
    smoothing-r.json
    optimize-r.json
    summary/summary.json
)
for file in "${files[@]}"; do
    mkdir -p "$(dirname "$root/tests/fixtures/$file")"
    git -C "$source" show "$commit:tests/fixtures/$file" > "$root/tests/fixtures/$file"
    echo "fetched $file"
done
# The clean-room specifications' data tables (specs/cleanroom/data), which the
# rewritten routines are checked against.
spec_data=(approx.json coefmat.json dnorm.json format.json format_g.json format_pval.json optimize.json quantile7.json round.json special.json)
mkdir -p "$root/tests/fixtures/cleanroom"
for file in "${spec_data[@]}"; do
    git -C "$source" show "$commit:specs/cleanroom/data/$file" > "$root/tests/fixtures/cleanroom/$file"
    echo "fetched cleanroom/$file"
done
# Datasets from phit's docs that its alias tests read (tests/aliases.php).
data=(schools.csv cbpp.csv)
mkdir -p "$root/tests/fixtures/data"
for file in "${data[@]}"; do
    git -C "$source" show "$commit:docs/data/$file" > "$root/tests/fixtures/data/$file"
    echo "fetched data/$file"
done

#!/usr/bin/env php
<?php

// Regenerate bootstrap.php and src/FunctionMap.php from the extension's API
// contract (tests/fixtures/php-api.json). A function is polyfilled when its
// implementation method exists; everything else stays extension-only.

declare(strict_types=1);

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

$api = json_decode(file_get_contents($root.'/tests/fixtures/php-api.json'), true, flags: JSON_THROW_ON_ERROR);
// Classes and interfaces in the contract are not functions: the fit and table
// classes are in classes/, and Phit\CsvReader is extension-only.
$api = array_filter($api, fn (array $spec) => ! isset($spec['methods']) && ! isset($spec['interface']));
ksort($api);

$families = [
    'normal' => 'Normal', 't' => 'StudentT', 'chisquare' => 'ChiSquare', 'f' => 'FisherF',
    'exponential' => 'Exponential', 'logistic' => 'Logistic', 'lognormal' => 'LogNormal',
    'gamma' => 'Gamma', 'beta' => 'Beta', 'binomial' => 'Binomial', 'poisson' => 'Poisson',
    'nbinom' => 'NegativeBinomial', 'nbinom_mu' => 'NegativeBinomialMu',
];
$operations = ['pdf', 'logpdf', 'pmf', 'logpmf', 'cdf', 'logcdf', 'sf', 'logsf', 'quantile', 'rng'];
// Matrix fits.
$models = ['fit_ols_matrix' => 'Ols', 'fit_logistic_matrix' => 'Logistic', 'fit_probit_matrix' => 'Probit',
    'fit_poisson_matrix' => 'Poisson'];
// Other entry points: name after Phit\ => [class, method].
$formulas = ['model_matrix' => ['ModelMatrix', 'build'], 'fit_ols' => ['Lm', 'fit'],
    'fit_generalized_linear' => ['Glm', 'fit'], 'fit_mixed_gaussian' => ['MixedFormula', 'lmer'],
    'fit_mixed_logistic' => ['MixedFormula', 'mixedLogistic'], 'fit_mixed_gaussian_matrix' => ['MixedModels', 'lmmFit'],
    'fit_mixed_gaussian_intercept_matrix' => ['MixedModels', 'lmm'], 'fit_mixed_logistic_matrix' => ['MixedModels', 'logisticMixed'],
    'draws_moments' => ['Draws', 'moments'], 'draws_covariance_map' => ['Draws', 'covarianceMap'],
    'draws_affine' => ['Draws', 'affine'],
    'predict' => ['Predict', 'predict'], 'summary' => ['Summary', 'summary'], 'tidy' => ['Summary', 'tidy'],
    'stat_density' => ['Smoothing', 'density'], 'stat_bw_nrd0' => ['Smoothing', 'bwNrd0'], 'stat_bw_nrd' => ['Smoothing', 'bwNrd'],
    'stat_approx' => ['Smoothing', 'approx'], 'stat_ecdf' => ['Smoothing', 'ecdf'],
    'optimize' => ['Optimize', 'optimize'], 'uniroot' => ['Optimize', 'uniroot'],
    'dist_uniform_rng' => ['Sampling', 'uniform'], 'dist_categorical_rng' => ['Sampling', 'categorical'],
    'dist_categorical_rows_rng' => ['Sampling', 'categoricalRows'], 'permutation_rng' => ['Sampling', 'permutation']];

function camel(string $name): string
{
    return lcfirst(str_replace(' ', '', ucwords(str_replace('_', ' ', $name))));
}

function target(string $fn, array $families, array $operations, array $models, array $formulas): ?array
{
    $name = substr($fn, strlen('Phit\\'));
    if (isset($formulas[$name])) {
        return ['Phit\\Polyfill\\'.$formulas[$name][0], $formulas[$name][1]];
    }
    if (isset($models[$name])) {
        return ['Phit\\Polyfill\\'.$models[$name], 'fit'];
    }
    if (str_starts_with($name, 'stat_')) {
        return ['Phit\\Polyfill\\Descriptive', camel(substr($name, strlen('stat_')))];
    }
    if (! str_starts_with($name, 'dist_')) {
        return null;
    }
    $name = substr($name, strlen('dist_'));
    $array = str_ends_with($name, '_array');
    $base = $array ? substr($name, 0, -strlen('_array')) : $name;
    // Longest family prefix first, so nbinom_mu wins over nbinom.
    uksort($families, fn ($a, $b) => strlen($b) <=> strlen($a));
    foreach ($families as $family => $class) {
        foreach ($operations as $operation) {
            if ($base === $family.'_'.$operation) {
                return ['Phit\\Polyfill\\Distribution\\'.$class, $operation.($array ? 'Array' : '')];
            }
        }
    }

    return null;
}

function literal(mixed $value): string
{
    return match (true) {
        $value === null => 'null',
        is_float($value) => var_export($value, true),
        default => var_export($value, true),
    };
}

$map = [];
$functions = [];
foreach ($api as $fn => $spec) {
    $target = target($fn, $families, $operations, $models, $formulas);
    if ($target === null || ! method_exists($target[0], $target[1])) {
        continue;
    }
    $method = new ReflectionMethod($target[0], $target[1]);
    $parameters = [];
    $arguments = [];
    foreach ($spec['parameters'] as $i => $parameter) {
        $type = $parameter['type'];
        $declaration = $type.' $'.$parameter['name'];
        if ($parameter['optional']) {
            $default = $parameter['default'];
            // Float defaults must stay floats (1.0, not 1).
            if (in_array(ltrim($type, '?'), ['float'], true) && is_int($default)) {
                $default = (float) $default;
            }
            $declaration .= ' = '.literal($default);
        }
        $parameters[] = $declaration;
        $arguments[] = '$'.$parameter['name'];
        $own = $method->getParameters()[$i] ?? null;
        if ($own === null || $own->getName() !== $parameter['name']) {
            fwrite(STDERR, "warning: {$target[0]}::{$target[1]} parameter $i does not match \${$parameter['name']}\n");
        }
    }
    $return = $spec['return_type'];
    $call = '\\'.$target[0].'::'.$target[1].'('.implode(', ', $arguments).')';
    // Model functions return a fit object and tidy() a table; the implementations return the arrays they hold.
    if (str_starts_with($short = substr($fn, strlen('Phit\\')), 'fit_')) {
        $call = "\\Phit\\Polyfill\\Objects\\Wrap::fit($call)";
    } elseif ($short === 'tidy') {
        $call = "\\Phit\\Polyfill\\Objects\\Wrap::table($call)";
    }
    $short = substr($fn, strlen('Phit\\'));
    $functions[] = "if (! function_exists('$fn')) {\n    function $short(".implode(', ', $parameters)."): $return\n    {\n        \\Phit\\Polyfill\\Internal\\Jit::refuse();\n\n        return $call;\n    }\n}\n";
    $map[$fn] = $target;
}

$bootstrap = "<?php\n\n// Generated by bin/generate-bootstrap from the phit API contract; do not edit.\n// Each function is defined only when the native extension has not defined it,\n// and refuses to run while OPcache's JIT compiles the process.\n\nnamespace Phit;\n\nif (\\extension_loaded('phit')) {\n    return;\n}\n\n// The fit and table classes, which the extension otherwise defines.\nforeach (['Fit', 'LinearFit', 'GeneralizedLinearFit', 'MixedGaussianFit', 'MixedLogisticFit', 'Table'] as \$class) {\n    require_once __DIR__.'/classes/'.\$class.'.php';\n}\n\n".implode("\n", $functions);
file_put_contents($root.'/bootstrap.php', $bootstrap);

$entries = '';
foreach ($map as $fn => [$class, $method]) {
    $entries .= "        '$fn' => [\\$class::class, '$method'],\n";
}
$entries = str_replace('[\\Phit\\Polyfill\\', '[', $entries);
$classMap = "<?php\n\ndeclare(strict_types=1);\n\nnamespace Phit\\Polyfill;\n\n// Generated by bin/generate-bootstrap; do not edit.\nfinal class FunctionMap\n{\n    public const array MAP = [\n$entries    ];\n}\n";
file_put_contents($root.'/src/FunctionMap.php', $classMap);
printf("polyfilled %d of %d functions\n", count($map), count($api));
